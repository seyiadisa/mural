{$API_DOMAIN} {
  # Access logging is intentionally disabled: no URL, cookie or authorization logging.
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "microphone=(self)"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://accounts.google.com https://api.openai.com wss://api.openai.com; frame-src https://accounts.google.com/gsi/; upgrade-insecure-requests"
  }
  handle /healthz {
    reverse_proxy api:8080 {
      header_up X-Mural-Proxy-Token {$ACCOUNTS_PROXY_TOKEN}
      header_up X-Mural-Client-IP {http.request.remote.host}
    }
  }
  handle /readyz {
    reverse_proxy api:8080 {
      header_up X-Mural-Proxy-Token {$ACCOUNTS_PROXY_TOKEN}
      header_up X-Mural-Client-IP {http.request.remote.host}
    }
  }
  handle /v1/* {
    reverse_proxy api:8080 {
      header_up X-Mural-Proxy-Token {$ACCOUNTS_PROXY_TOKEN}
      header_up X-Mural-Client-IP {http.request.remote.host}
    }
  }
  handle {
    reverse_proxy web:80
  }
}
